# Copy this file to .env and fill in real values. .env is ignored by git; never commit it.

# MongoDB connection string (required)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# Secret used to sign login tokens. Optional: if unset, a key file (backend/.jwt_secret) is
# generated once and reused. Set it explicitly in production.
JWT_SECRET=

# Optional local admin login that does not need a member in the database.
# Leave both empty (or remove them) to disable it. Do not enable it in production.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
